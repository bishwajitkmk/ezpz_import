      "translations": {
        "bn": {
          "questionText": "পৃথিবীর অভ্যন্তরে কেন্দ্র হতে কোনো বিন্দুর দূরত্ব d বনাম অভিকর্ষজ ত্বরণ ‘g’ এর লেখচিত্র-",
          "solutionText": "পৃথিবীর কেন্দ্র হতে যত পৃষ্ঠের দিকে যাওয়া যায় অভিকর্ষজ ত্বরণ $g$ -এর মান তত বাড়ে। 'ক' নং লেখচিত্র হতে দেখা যায়, কেন্দ্র হতে যত উপরের দিকে যায় g-এর মান তত বাড়ে।\n${g}^{′}=g(1-\\frac{h}{R})$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": true,
          "body": {
            "bn": "ক"
