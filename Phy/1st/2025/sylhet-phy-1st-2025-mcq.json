    {
      "clientId": "sylhet-2025-physics1st-q5",
      "curriculum": {
        "path": "hsc/physics/1st/chapter-7"
      },
      "questionNumber": "5",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "পয়সনের অনুপাতের সমীকরণ নিচের কোনটি?",
          "solutionText": "পয়সনের অনুপাতের (Poisson's Ratio) সঠিক সমীকরণটি হলো:$\\sigma=-\\frac{\\text{পার্শ্ব বিকৃতি}}{\\text{দৈর্ঘ্য বিকৃতি}}=-\\frac{\\frac{\\Deltad}{D}}{\\frac{\\DeltaL}{L}}$এখানে,$\\sigma$ (সিগমা) = পয়সনের অনুপাত$D$ = আদি ব্যাস (বা প্রস্থ)$\\Deltad$ = ব্যাসের পরিবর্তন$L$ = আদি দৈর্ঘ্য$\\DeltaL$ = দৈর্ঘ্যের পরিবর্তনঋণাত্মক চিহ্নটি পরিহার করে, $\\sigma=\\frac{\\Deltad\\cdotL}{D\\cdot\\DeltaL}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "$\\sigma=\\frac{dD}{LI}$"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": true,
          "body": {
            "bn": "$\\sigma=\\frac{\\Deltad\\cdotL}{D\\cdot\\DeltaL}$"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": false,
          "body": {
            "bn": "$\\sigma=\\frac{dl}{LD}$"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "$\\sigma=\\frac{LD}{dl}$"
          }
        }
      ],
