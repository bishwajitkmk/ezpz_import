    {
      "clientId": "sylhet-2019-physics1st-q6",
      "curriculum": {
        "path": "hsc/physics/1st/chapter-7"
      },
      "questionNumber": "6",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "সরল ছন্দিত স্পন্দন গতি সম্পন্ন একটি কণার সরণের রাশিমালা হলো-\ni. $x=A\\sin⁡2\\pint$\nii. $y=ax-b{x}^{2}$\niii. $x=A\\sin⁡\\omegat$\nনিচের কোনটি সঠিক?",
          "solutionText": "সঠিক উত্তর হলো: i ও iii।ব্যাখ্যা: সরল ছন্দিত স্পন্দন গতিসম্পন্ন কোনো কণার সরণের সাধারণ সমীকরণ হলো:$x=A\\sin⁡\\omegat$ (যখন আদি দশা $\\delta=0$ )এখানে, $A=$ কণার বিস্তার বা বিস্তৃতি, $\\omega=$ কৌণিক কম্পাঙ্ক এবং $t=$ সময়। সুতরাং iii নং তথ্যটি সঠিক।আবার, আমরা জানি কৌণিক কম্পাঙ্ক ( $\\omega$ ) এবং কম্পাঙ্কের ( $n$ ) মধ্যকার সম্পর্ক হলো:$\\omega=2\\pin$এই $\\omega$ -এর মানটি সরণের সমীকরণে প্রতিস্থাপন করলে আমরা পাই:$x=A\\sin⁡2\\pint$সুতরাং i নং তথ্যটিও সঠিক।ii নং তথ্যটি কেন ভুল:$y=ax-b{x}^{2}$ সমীকরণটি হলো একটি পরাবৃত্তের (Parabola) সমীকরণ। এটি পদার্থবিজ্ঞানের 'গতিবিদ্যা' অধ্যায়ে প্রাস বা প্রক্ষেপকের $(Projectile)$ চলনপথ বা গতিপথের সমীকরণ নির্দেশ করে। সরল ছন্দিত স্পন্দনের সাথে এর কোনো সম্পর্ক নেই।"
        }
      },
