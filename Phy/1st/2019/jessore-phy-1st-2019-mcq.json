      "questionNumber": "7",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "নিচের উদ্দীপকটি পড় এবং প্রশ্নের উত্তর দাও: AB দণ্ডটি XY অক্ষের সাপেক্ষে ঘূর্ণনশীল। দণ্ডের মোট দৈর্ঘ্য 2m এবং মোট ভর 2kg |\nQ. চিত্র-ক এর জড়তার ভ্রামক I1 এবং চিত্র-খ এর জড়তার ভ্রামক I2, হলে, কোনটি সঠিক?",
          "solutionText": "$\\begin{matrix} & \\frac{{I}_{1}}{{I}_{2}}=\\frac{\\frac{1}{3}{ML}^{2}}{\\frac{1}{12}{ML}^{2}}=\\frac{1}{3}\\times\\frac{12}{1}=\\frac{4}{1}\\\\ & ∴{I}_{1}:{I}_{2}=4:1\\end{matrix}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "I1 : I2 = 1 : 1"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": false,
          "body": {
            "bn": "I1 : I2 = 1 : 2"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": true,
          "body": {
            "bn": "I1 : I2 = 4 : 1"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "I1 : I2 = 1 : 4"
          }
        }
      ],
