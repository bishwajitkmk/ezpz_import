    {
      "clientId": "barisal-2021-physics1st-q24",
      "curriculum": {
        "path": "hsc/physics/1st/chapter-8"
      },
      "questionNumber": "24",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "$K$ বল ধ্রুবকের একটি স্প্রিং এ $T$ পরিমাণ টান প্রয়োগ করা হলো। ফলে দৈর্ঘ্য বৃদ্ধি হয় $x$ পরিমাণ। এ অবস্থায় স্প্রিংটিতে সঞ্চিত বিভবশক্তি হবে—",
          "solutionText": "হুকের সূত্র অনুযায়ী, স্প্রিং-এর ওপর প্রয়োগকৃত বল (এখানে টান, $T$ ) এবং স্প্রিংয়ের দৈর্ঘ্য বৃদ্ধির ( $x$ ) মধ্যকার সম্পর্কটি হলো:\n$T=kx$\nবা, $x=\\frac{T}{k}$\nআমরা জানি,\nকোনো স্প্রিং-এ সঞ্চিত বিভবশক্তি, ${E}_{p}=\\frac{1}{2}k{x}^{2}$\nবা, ${E}_{p}=\\frac{1}{2}k{(\\frac{T}{k})}^{2}$ ( $x$ -এর মান বসিয়ে)\nবা, ${E}_{p}=\\frac{1}{2}k(\\frac{{T}^{2}}{{k}^{2}})$\nবা, ${E}_{p}=\\frac{{T}^{2}}{2k}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "$\\frac{2{T}^{2}}{k}$"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": true,
          "body": {
            "bn": "$\\frac{{T}^{2}}{2k}$"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": false,
          "body": {
            "bn": "$\\frac{{T}^{2}}{2x}$"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "$\\frac{2k}{{T}^{2}}$"
          }
        }
      ],
