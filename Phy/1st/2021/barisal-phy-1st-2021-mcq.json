      "translations": {
        "bn": {
          "questionText": "$|\\vec{A}+\\vec{B}|=|\\vec{A}-\\vec{B}|$ হলে $\\vec{A}$ ও $\\vec{B}$ এর মধ্যবর্তী কোণ হবে-",
