        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": false,
          "body": {
            "bn": "$R=\\frac{{d}^{2}}{4h}+\\frac{h}{2}$"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "$R=\\frac{{d}^{2}}{6h}+\\frac{h}{4}$"
          }
        }
