      "questionNumber": "1",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "স্ফেরোমিটারের সাহায্যে কোনো তলের বক্রতার ব্যাসার্ধ নির্ণয় এর সমীকরণ কোনটি?",
          "solutionText": "যে যন্ত্রের সাহায্যে গোলকীয় তলের বক্রতার ব্যাসার্ধ এবং কাচ বা অন্যান্য পাতের পুরুত্ব মাপা যায় তাকে স্ফেরোমিটার বলে। $R=\\frac{{d}^{2}}{6h}+\\frac{h}{2}$যেখানে d = স্ফেরোমিটারের যেকোনো দুই পায়ের মধ্যবর্তী গড় দূরত্বের সমীকরণh= সমতল কাচ পাতের পাঠ ও পরিক্ষণীয় গোলীয় তলের পাঠের পার্থক্য।"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": true,
          "body": {
            "bn": "$R=\\frac{{d}^{2}}{6h}+\\frac{h}{2}$"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
