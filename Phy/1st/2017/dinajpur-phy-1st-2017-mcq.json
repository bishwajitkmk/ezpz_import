          "body": {
            "bn": "(8î - 2ĵ - k) জুল"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "$(-4\\hat{i}+5\\hat{j}+3\\hat{k})$ জুল"
          }
        }
      ],
