      "translations": {
        "bn": {
          "questionText": "একটি কণার উপর $\\vec{F}=(2\\hat{i}+2\\hat{j}+\\hat{k})N$ বল প্রয়োগে কণাটির সরণ $\\vec{r}=(6\\hat{i}-3\\hat{j}-$ $2\\hat{k})m$ হয়। প্রয়োগকৃত বল কর্তৃক সম্পাদিত কাজের\nপরিমাণ হবে-",
          "solutionText": "$\\begin{matrix}W=\\vec{F}\\cdot\\vec{r} & =(2\\hat{i}+2\\hat{j}+\\hat{k})\\cdot(6\\hat{i}-3\\hat{j}-2\\hat{k})\\\\ & =12-6-2\\\\ & =4\\end{matrix}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "20 জুল"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": true,
          "body": {
            "bn": "4 জুল"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
