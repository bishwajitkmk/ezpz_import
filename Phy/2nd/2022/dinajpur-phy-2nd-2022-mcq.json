      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "উদ্দীপকটি পড়ো এবং প্রশ্নের উত্তর দাও: n সংখ্যক C ধারকত্বের ধারককে V ভোল্ট উৎসের সাথে যথাক্রমে শ্রেণি ও সমান্তরালে যুক্ত করা হলো।Q. উদ্দীপকে শ্রেণি ও সমান্তরাল তুল্যধারকের সঞ্চিত শক্তি যথাক্রমে Us ও Up হলে নিচের কোনটি সঠিক?",
          "solutionText": "$\\begin{matrix} & {U}_{s}=\\frac{1}{2}{C}_{s}{V}^{2}\\text{ এবং }{U}_{p}=\\frac{1}{2}{C}_{p}{V}^{2}\\text{ বা, }\\frac{{U}_{p}}{{U}_{s}}=\\frac{\\frac{1}{2}{C}_{p}{V}^{2}}{\\frac{1}{2}{C}_{s}{V}^{2}}\\\\ & \\text{ বা, }\\frac{{U}_{s}}{{U}_{s}}=\\frac{{n}^{2}{C}^{2}}{C}\\text{ বা, }{U}_{p}={n}^{2}{u}_{s}\\text{ । }\\end{matrix}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "${U}_{P}=\\frac{{U}_{s}}{n}$"
