      "questionNumber": "4",
      "formatCode": "mcq_single",
      "translations": {
        "bn": {
          "questionText": "উদ্দীপকটি পড়ো এবং প্রশ্নের উত্তর দাও: n সংখ্যক C ধারকত্বের ধারককে V ভোল্ট উৎসের সাথে যথাক্রমে শ্রেণি ও সমান্তরালে যুক্ত করা হলো।Q. শ্রেণি ও সমান্তরালে তুল্য ধারকত্ব যথাক্রমে Cs ও Cp হলে নিচের কোনটি সঠিক?",
          "solutionText": "${C}_{s}=\\frac{C}{n}$ এবং ${C}_{p}=nC$ , সুতরাং, $\\frac{{C}_{p}}{{C}_{s}}=\\frac{nC}{\\frac{C}{n}}={n}^{2}$ বা, ${C}_{p}={n}^{2}{C}_{s}$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": true,
          "body": {
            "bn": "${C}_{p}={n}^{2}{C}_{s}$"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": false,
          "body": {
            "bn": "${C}_{p}=n{C}_{s}$"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": false,
          "body": {
            "bn": "${C}_{p}=\\frac{{C}_{s}}{n}$"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": false,
          "body": {
            "bn": "${C}_{p}=\\frac{{C}_{s}}{{n}^{2}}$"
          }
        }
      ],
