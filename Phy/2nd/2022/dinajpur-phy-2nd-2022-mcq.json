          "body": {
            "bn": "${U}_{p}=n{U}_{s}$"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": true,
          "body": {
            "bn": "${U}_{p}={n}^{2}{U}_{s}$"
          }
        }
