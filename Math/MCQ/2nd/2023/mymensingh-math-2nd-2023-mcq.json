      "translations": {
        "bn": {
          "questionText": "tan−1P + tan−1 q = $\\frac{\\pi}{4}$ হলে-",
          "solutionText": "$\\begin{matrix} & {\\tan}^{-1}⁡p+{\\tan}^{-1}⁡q=\\frac{\\pi}{4}\\\\ & \\text{ বা, }\\frac{p+q}{1-pq}=\\tan⁡\\frac{\\pi}{4}=1\\text{ বা, }p+q=1-pq\\end{matrix}$$∴p+q+pq=1$"
        }
      },
      "choices": [
        {
          "ordinal": 1,
          "key": "A",
          "isCorrect": false,
          "body": {
            "bn": "pq = 1"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "isCorrect": false,
          "body": {
            "bn": "p + q = 1"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "isCorrect": false,
          "body": {
            "bn": "p + q - pq = 1"
          }
        },
        {
          "ordinal": 4,
          "key": "D",
          "isCorrect": true,
          "body": {
            "bn": "p + q + pq = 1"
          }
        }
      ],
