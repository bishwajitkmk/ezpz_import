      "clientId": "dhaka-2017-math1st-cq06",
      "curriculum": {
        "path": "hsc/math/1st/chapter-7"
      },
      "questionNumber": "06",
      "formatCode": "cq",
      "translations": {
        "bn": {
          "questionText": "দৃশ্যকল্প- I :\n[IMG_0]\nদৃশ্যকল্প-II : p $=\\tan\\theta\\tan2\\theta\\tan\\alpha$ .",
          "solutionText": null
        }
      },
      "parts": [
        {
          "ordinal": 1,
          "key": "A",
          "prompt": {
            "bn": "$\\sin{25}^{\\circ}+\\cos{25}^{\\circ}$ এর মান কত?"
          },
          "solution": {
            "bn": "$\\begin{matrix} & \\sin{25}^{\\circ}+\\cos{25}^{\\circ}=\\sin{25}^{\\circ}+\\cos({90}^{\\circ}-{65}^{\\circ})\\\\ & =\\sin{25}^{\\circ}+\\sin{65}^{\\circ}\\\\ & =2\\sin\\frac{{65}^{\\circ}+{25}^{\\circ}}{2}\\cos\\frac{{65}^{\\circ}-{25}^{\\circ}}{2}\\\\ & =2\\sin{45}^{\\circ}\\cos{20}^{\\circ}\\\\ & =2\\times\\frac{1}{\\sqrt{2}}\\times\\cos{20}^{\\circ}\\\\ & =\\sqrt{2}\\cos{20}^{\\circ}\\text{ (Ans.) }\\end{matrix}$"
          }
        },
        {
          "ordinal": 2,
          "key": "B",
          "prompt": {
            "bn": "দৃশ্যকল্প-I হতে b এবং c এর মান নির্ণয় কর।"
          },
          "solution": {
            "bn": "$△ABC-\\Omega,\\theta+2\\theta+{120}^{\\circ}={180}^{\\circ}$\nবা, $3\\theta={60}^{\\circ}$\n$∴\\theta={20}^{\\circ}$\n$∴A=\\theta={20}^{\\circ}$ এবং $B=2\\theta=2\\times{20}^{\\circ}={40}^{\\circ}$\nধরি, $BC=a=2$\n$∴$ ত্রিভুজের সাইন সূত্রানুসারে,\n$\\frac{a}{\\sinA}=\\frac{b}{\\sinB}=\\frac{c}{\\sinC}$\nবা, $\\frac{2}{\\sin{20}^{\\circ}}=\\frac{b}{\\sin{40}^{\\circ}}=\\frac{c}{\\sin{120}^{\\circ}}$\n$∴\\frac{b}{\\sin{40}^{\\circ}}=\\frac{2}{\\sin{20}^{\\circ}}$\nবা, $b=\\frac{2\\sin{40}^{\\circ}}{\\sin{20}^{\\circ}}$\n$∴b=3.76$ (প্রায়) (Ans.) \nএবং $\\frac{c}{\\sin{120}^{\\circ}}=\\frac{2}{\\sin{20}^{\\circ}}$\nবা, $c=\\frac{2\\sin{120}^{\\circ}}{\\sin{20}^{\\circ}}$\n$∴c=5.06$ (প্রায়) (Ans.)"
          }
        },
        {
          "ordinal": 3,
          "key": "C",
          "prompt": {
            "bn": "দৃশ্যকল্প-II হতে দেখাও যে, $p=\\sqrt{3}$ ."
          },
          "solution": {
            "bn": "চিত্রানুসারে, $\\theta+\\alpha+{80}^{\\circ}={180}^{\\circ}$\nবা, ${20}^{\\circ}+\\alpha+{80}^{\\circ}={180}^{\\circ}$\n$∴\\alpha={80}^{\\circ}$\nবামপক্ষ $=p$\n$=\\tan\\theta\\tan2\\theta\\tan\\alpha$\n$=\\tan{20}^{\\circ}\\tan{40}^{\\circ}\\tan{80}^{\\circ}$\n$=\\tan{20}^{\\circ}\\tan({60}^{\\circ}-{20}^{\\circ})\\tan({60}^{\\circ}+{20}^{\\circ})$\n$=\\tan{20}^{\\circ}\\cdot\\frac{\\tan{60}^{\\circ}-\\tan{20}^{\\circ}}{1+\\tan{60}^{\\circ}\\cdot\\tan{20}^{\\circ}}\\cdot\\frac{\\tan{60}^{\\circ}+\\tan{20}^{\\circ}}{1-\\tan{60}^{\\circ}\\cdot\\tan{20}^{\\circ}}$\n$=\\tan{20}^{\\circ}\\cdot\\frac{\\sqrt{3}-\\tan{20}^{\\circ}}{1+\\sqrt{3}\\tan{20}^{\\circ}}\\cdot\\frac{\\sqrt{3}+\\tan{20}^{\\circ}}{1-\\sqrt{3}\\tan{20}^{\\circ}}$\n$=\\tan{20}^{\\circ}\\cdot\\frac{(\\sqrt{3}{)}^{2}-{\\tan}^{2}{20}^{\\circ}}{1-{(\\sqrt{3}\\tan{20}^{\\circ})}^{2}}$\n$=\\tan{20}^{\\circ}\\cdot\\frac{3-{\\tan}^{2}{20}^{\\circ}}{1-3{\\tan}^{2}{20}^{\\circ}}$\n$=\\frac{3\\tan{20}^{\\circ}-{\\tan}^{3}{20}^{\\circ}}{1-3{\\tan}^{2}{20}^{\\circ}}$\n$=\\tan({3.20}^{\\circ})$\n$=\\tan{60}^{\\circ}=\\sqrt{3}$\n= ডানপক্ষ\n$∴p=\\sqrt{3}$ (দেখানো হলো)"
          }
        }
      ],
